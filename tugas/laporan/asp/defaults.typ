#let numbering = (
  heading: "1.1.",
  front: "i",
  back: "body",
)

#let caption = (
  size: 10pt,
  gap: 0.65em,
)

#let labels = (
  chapter: "CHAPTER",
  appendix: "Lampiran",
  code: "Code",
)

#let code = (
  fill: luma(240),
  font: "JetBrainsMonoNL NF",
  size: 10pt,
)

#let headings = (
  h1: (size: 12pt, above: 24pt, below: 18pt, pagebreak: true),
  h2: (size: 12pt, above: 24pt, below: 18pt, indent: 0cm),
  h3: (size: 12pt, above: 14pt, below: 18pt, indent: 0cm),
  h4: (size: 12pt, above: 12pt, below: 18pt, indent: 0cm),
)
